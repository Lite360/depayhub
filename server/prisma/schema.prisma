// server/prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(uuid())
  fullName     String
  username     String   @unique
  email        String   @unique
  passwordHash String
  pinHash      String
  role         Role     @default(SUBSCRIBER)
  status       UserStatus @default(ACTIVE)
  
  wallet         Wallet?
  sessions       Session[]
  trustedDevices TrustedDevice[]
  securityEvents SecurityEvent[]
  transactions   Transaction[]
  vendorApp      VendorApplication?
  fundingAccounts FundingAccount[]
  receipts       Receipt[]
  notifications  Notification[]
  apiKeys        ApiKey[]
  
  referralsMade  Referral[] @relation("ReferralsMade")
  referral       Referral?  @relation("ReferralReceived")
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Role {
  SUBSCRIBER
  VENDOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model Wallet {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  
  cachedBalance Decimal @default(0.00) @db.Decimal(19, 4)
  
  transactions WalletTransaction[]
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model WalletTransaction {
  id              String   @id @default(uuid())
  walletId        String
  wallet          Wallet   @relation(fields: [walletId], references: [id])
  type            TransactionType
  amount          Decimal  @db.Decimal(19, 4)
  reference       String   @unique
  description     String?
  
  ledgerEntries   LedgerEntry[]
  
  createdAt       DateTime @default(now())
}

enum TransactionType {
  CREDIT
  DEBIT
}

model LedgerEntry {
  id                  String   @id @default(uuid())
  walletTransactionId String
  walletTransaction   WalletTransaction @relation(fields: [walletTransactionId], references: [id])
  amount              Decimal  @db.Decimal(19, 4)
  balanceAfter        Decimal  @db.Decimal(19, 4)
  
  createdAt           DateTime @default(now())
}

model Transaction {
  id                String   @id @default(uuid())
  reference         String   @unique
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  service           String   // e.g., AIRTIME, DATA
  provider          String   // e.g., VTU_NAIJA
  providerReference String?
  amount            Decimal  @db.Decimal(19, 4)
  providerCost      Decimal  @db.Decimal(19, 4)
  status            TxStatus @default(PENDING)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

enum TxStatus {
  PENDING
  PROCESSING
  SUCCESSFUL
  FAILED
  REVERSED
  REFUNDED
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  token        String   @unique
  device       String?
  ip           String?
  createdAt    DateTime @default(now())
  expiresAt    DateTime
}

model TrustedDevice {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  deviceId     String   @unique
  name         String?
  browser      String?
  lastActive   DateTime
  ip           String?
  createdAt    DateTime @default(now())
}

model SecurityEvent {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  eventType    String
  ip           String?
  country      String?
  state        String?
  city         String?
  device       String?
  browser      String?
  createdAt    DateTime @default(now())
}

model VendorApplication {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  status       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model FundingAccount {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  provider     String   // e.g. PAYMENTPOINT, ASPIFY
  accountNumber String
  accountName  String
  bankName     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@unique([userId, provider])
}

model PaymentWebhook {
  id                 String   @id @default(uuid())
  provider           String   // PAYMENTPOINT, ASPIFY
  providerReference  String   @unique
  status             WebhookStatus @default(PENDING)
  payload            Json
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

enum WebhookStatus {
  PENDING
  PROCESSED
  FAILED
  IGNORED
}

model Receipt {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  reference    String   @unique
  service      String
  totalAmount  Decimal  @db.Decimal(19, 4)
  fee          Decimal  @db.Decimal(19, 4)
  status       String
  createdAt    DateTime @default(now())
  
  items        ReceiptItem[]
}

model ReceiptItem {
  id           String   @id @default(uuid())
  receiptId    String
  receipt      Receipt  @relation(fields: [receiptId], references: [id])
  name         String
  amount       Decimal  @db.Decimal(19, 4)
}

model Notification {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  type         String   // EMAIL, IN_APP
  title        String
  message      String
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model ServiceCategory {
  id           String   @id @default(uuid())
  name         String   @unique // e.g. AIRTIME, DATA
  description  String?
  isActive     Boolean  @default(true)
  
  plans        ServicePlan[]
}

model VtuProvider {
  id           String   @id @default(uuid())
  name         String   @unique // e.g. VTU_NAIJA, INLOMAX
  isActive     Boolean  @default(true)
  
  pricingTiers Pricing[]
}

model ServicePlan {
  id                String   @id @default(uuid())
  categoryId        String
  category          ServiceCategory @relation(fields: [categoryId], references: [id])
  name              String   // e.g. MTN 1GB
  code              String   @unique // e.g. mtn-1gb
  network           String?  // e.g. MTN, AIRTEL
  isActive          Boolean  @default(true)
  
  pricingTiers      Pricing[]
}

model Pricing {
  id              String   @id @default(uuid())
  planId          String
  plan            ServicePlan @relation(fields: [planId], references: [id])
  providerId      String
  provider        VtuProvider @relation(fields: [providerId], references: [id])
  
  providerCost    Decimal  @db.Decimal(19, 4)
  subscriberPrice Decimal  @db.Decimal(19, 4)
  vendorPrice     Decimal  @db.Decimal(19, 4)
  apiPrice        Decimal  @db.Decimal(19, 4)
  
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([planId, providerId])
}

model ApiKey {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  keyHash      String   @unique  // hashed version of the key
  keyPrefix    String            // first 8 chars for identification, e.g. NF_live_a
  name         String            // friendly name e.g. "Production Key"
  isActive     Boolean  @default(true)
  lastUsedAt   DateTime?
  
  scopes       ApiKeyScope[]
  usage        ApiUsage[]
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ApiKeyScope {
  id           String   @id @default(uuid())
  apiKeyId     String
  apiKey       ApiKey   @relation(fields: [apiKeyId], references: [id])
  scope        String   // e.g. AIRTIME, DATA, CABLE, ELECTRICITY
  
  @@unique([apiKeyId, scope])
}

model ApiUsage {
  id           String   @id @default(uuid())
  apiKeyId     String
  apiKey       ApiKey   @relation(fields: [apiKeyId], references: [id])
  endpoint     String
  method       String
  statusCode   Int
  ip           String?
  
  createdAt    DateTime @default(now())
}

model Referral {
  id              String   @id @default(uuid())
  referrerId      String
  referrer        User     @relation("ReferralsMade", fields: [referrerId], references: [id])
  referredUserId  String   @unique
  referredUser    User     @relation("ReferralReceived", fields: [referredUserId], references: [id])
  status          String   @default("PENDING") // PENDING, COMPLETED
  rewardAmount    Decimal  @db.Decimal(19, 4)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

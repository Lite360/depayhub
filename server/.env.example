# Environment configuration
NODE_ENV=development
PORT=3000

# Database Connection (Neon/PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://user:password@hostname:5432/depayhub?sslmode=require"

# JWT Secret for authenticating users
JWT_SECRET="super-secret-key-change-this-in-production"

# Email Service (SMTP)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-password"
SMTP_FROM="noreply@depayhub.com"

# External VTU Provider API Keys (if using real providers instead of Mock)
VTPASS_API_KEY="your-vtpass-key"
FLUTTERWAVE_SECRET="your-flutterwave-secret"
